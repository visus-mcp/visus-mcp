{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "bin/**/*.ts",
    "stacks/**/*.ts",
    "../shared/**/*.ts",
    "../lambdas/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "cdk.out"]
}
